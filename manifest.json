{
  "manifest_version": 3,
  "name": "YouTube Utilities & Link Opener",
  "version": "1.1",
  "description": "Batch open YouTube videos from Google search and extract/open channel pages from open video tabs.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://*.google.com/*",
    "*://google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Utilities",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/*", "*://google.com/*"],
      "js": ["content.js"]
    }
  ]
}